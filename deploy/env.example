# Modelo do /opt/appgym/.env da VM. Copie, preencha e deixe com chmod 600.
# Nunca versione o arquivo preenchido. Um comentário por linha, nunca no fim do valor.
# O banco (DATABASE_URL/USER/PASSWORD) já vem do compose.prod.yml.

# Senha do Postgres do container. Gere com: openssl rand -hex 24
POSTGRES_PASSWORD=

# Pelo menos 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=

# Usuário criado no primeiro boot com o banco vazio.
APP_USER_EMAIL=
APP_USER_PASSWORD=

# E-mails que podem criar conta, separados por vírgula. Vazio = ninguém.
APP_ALLOWED_EMAILS=

# Login social. Google e Apple exigem HTTPS fora do localhost.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=

# Opcionais
# JWT_EXPIRATION_HOURS=720
# JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=50 -XX:+UseSerialGC
