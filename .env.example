# Copie para .env. O docker compose lê este arquivo; nunca versione o .env.

# Usuário criado no primeiro boot, só com o banco vazio. Depois o e-mail pode ser trocado no Perfil.
APP_USER_EMAIL=you@appgym.local
APP_USER_PASSWORD=appgym

# Pelo menos 32 caracteres.
JWT_SECRET=dev-secret-change-me-in-production-32

# Postgres local do docker compose. Em produção, use a URL do provedor
# (Neon, Supabase ou Render), por exemplo:
# DATABASE_URL=postgresql://user:password@host:5432/appgym?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/appgym
DATABASE_USER=appgym
DATABASE_PASSWORD=appgym

# Cadastro por convite: e-mails que podem criar conta, separados por vírgula. Vazio = ninguém novo.
APP_ALLOWED_EMAILS=

# Login social. Cada botão só aparece quando a variável dele está preenchida.
GOOGLE_CLIENT_ID=
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
